rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lessons & quizzes: any logged-in user can read; only admins can write.
    match /lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /quizzes/{lessonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;

      match /questions/{questionId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.token.admin == true;
      }
    }

    // Users: a user can read/update only their own profile. Admins can read all.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true);
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true);
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Scores: a user can write only their own scores. Admins can read all (for leaderboard/admin panel).
    match /scores/{scoreId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Login logs: written only by the authenticated user themself, readable only by admins.
    match /loginLogs/{logId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
